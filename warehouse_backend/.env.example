# Configuración Básica de Django
SECRET_KEY=cambia-esto-por-una-clave-segura-de-50-caracteres-o-mas
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# Conexión a Base de Datos PostgreSQL local
# Formato: postgres://usuario:contraseña@host:puerto/nombre_base_de_datos
DATABASE_URL=postgres://usuario:password@localhost:5432/warehouse_iq

# Orígenes Permitidos para el Frontend (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Configuración de Servidor de Correos (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password
EMAIL_USE_TLS=True

# Integración de Inteligencia Artificial (Chatbot Groq)
# Obtén tu API key en https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_de_groq
GROQ_MODEL=llama-3.3-70b-versatile

# Datos del Sistema
SYSTEM_NAME=Warehouse_iq
SYSTEM_URL=http://localhost:8000
